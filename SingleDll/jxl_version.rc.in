// Version resource for the single jxl.dll, configured by jxl_dll.cmake.
// No #include on purpose: the resource compiler fails on clang's headers under
// ClangCL (RC1012), so the winver.h constants are written as numbers.

1 VERSIONINFO
 FILEVERSION @JPEGXL_MAJOR_VERSION@,@JPEGXL_MINOR_VERSION@,@JPEGXL_PATCH_VERSION@,0
 PRODUCTVERSION @JPEGXL_MAJOR_VERSION@,@JPEGXL_MINOR_VERSION@,@JPEGXL_PATCH_VERSION@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "the JPEG XL Project Authors"
      VALUE "FileDescription", "JPEG XL encoder and decoder (libjxl, single DLL)"
      VALUE "FileVersion", "@JXL_DLL_VERSION_STRING@"
      VALUE "InternalName", "jxl"
      VALUE "LegalCopyright", "Copyright (c) the JPEG XL Project Authors. BSD-3-Clause."
      VALUE "OriginalFilename", "jxl.dll"
      VALUE "ProductName", "libjxl (single-DLL build, libjxl-delphi)"
      VALUE "ProductVersion", "@JXL_DLL_VERSION_STRING@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
