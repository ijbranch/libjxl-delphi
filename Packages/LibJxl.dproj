        <VerInfo_MajorVer>1</VerInfo_MajorVer>
        <VerInfo_MinorVer>0</VerInfo_MinorVer>
        <VerInfo_Release>0</VerInfo_Release>
        <VerInfo_Keys>CompanyName=Ian Branch;FileDescription=LibJxl - JPEG XL (libjxl) binding for Delphi;FileVersion=1.0.0.11;InternalName=LibJxl;LegalCopyright=Copyright (c) 2026 Ian Branch;LegalTrademarks=;OriginalFilename=;ProductName=libjxl;ProductVersion=1.0.0.11;Comments=;CFBundleName=</VerInfo_Keys>
        <VerInfo_Build>11</VerInfo_Build>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1_Win64)'!=''">
        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <VerInfo_AutoIncVersion>true</VerInfo_AutoIncVersion>
        <VerInfo_MajorVer>1</VerInfo_MajorVer>
        <VerInfo_MinorVer>0</VerInfo_MinorVer>
        <VerInfo_Release>0</VerInfo_Release>
        <VerInfo_Keys>CompanyName=Ian Branch;FileDescription=LibJxl - JPEG XL (libjxl) binding for Delphi;FileVersion=1.0.0.16;InternalName=LibJxl;LegalCopyright=Copyright (c) 2026 Ian Branch;LegalTrademarks=;OriginalFilename=;ProductName=libjxl;ProductVersion=1.0.0.16;Comments=;CFBundleName=</VerInfo_Keys>
        <VerInfo_Build>16</VerInfo_Build>
