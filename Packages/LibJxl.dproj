        <VerInfo_Keys>CompanyName=Ian Branch;FileDescription=LibJxl - JPEG XL (libjxl) binding for Delphi;FileVersion=1.0.0.19;InternalName=LibJxl;LegalCopyright=Copyright (c) 2026 Ian Branch;LegalTrademarks=;OriginalFilename=;ProductName=libjxl;ProductVersion=1.0.0.19;Comments=;CFBundleName=</VerInfo_Keys>
        <VerInfo_Build>19</VerInfo_Build>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="rtl.dcp"/>
        <DCCReference Include="vcl.dcp"/>
        <DCCReference Include="vclimg.dcp"/>
        <DCCReference Include="..\Source\Jxl.Api.Types.pas"/>
        <DCCReference Include="..\Source\Jxl.Api.Decode.pas"/>
        <DCCReference Include="..\Source\Jxl.Api.Encode.pas"/>
        <DCCReference Include="..\Source\Jxl.Api.Threads.pas"/>
        <DCCReference Include="..\Source\Jxl.Api.Cms.pas"/>
        <DCCReference Include="..\Source\Jxl.Graphic.pas"/>
        <BuildConfiguration Include="Base">
