        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <VerInfo_AutoIncVersion>true</VerInfo_AutoIncVersion>
        <VerInfo_MajorVer>1</VerInfo_MajorVer>
        <VerInfo_MinorVer>0</VerInfo_MinorVer>
        <VerInfo_Release>0</VerInfo_Release>
        <VerInfo_Keys>CompanyName=Ian Branch;FileDescription=LibJxl - JPEG XL (libjxl) binding for Delphi;FileVersion=1.0.0.13;InternalName=LibJxl;LegalCopyright=Copyright (c) 2026 Ian Branch;LegalTrademarks=;OriginalFilename=;ProductName=libjxl;ProductVersion=1.0.0.13;Comments=;CFBundleName=</VerInfo_Keys>
